# Caddy obtains and renews the certificate automatically. No certbot, no cron.
# Replace the hostname; everything else can stay.
#
# HSTS is NOT on by default, so it is set explicitly. `preload` is deliberately
# left off: joining the preload list is easy and leaving it is painful.

raidbingo.com {
	reverse_proxy localhost:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"

		# The only third party is Google Fonts. Everything else is same-origin,
		# and there is no inline script beyond the state blob the page embeds.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
	}

	encode zstd gzip
	# Logs go to journald (Caddy's default) — read them with
	# `journalctl -u caddy`. Deliberately not a file: on Ubuntu the packaged
	# unit cannot write to /var/log/caddy even when the directory is owned by
	# the caddy user, and the service fails to start with a permission error
	# that is nowhere near obvious.
}

# Uncomment if www also resolves to this machine. Without it, visitors to
# www get a certificate error rather than a redirect, because Caddy only
# issues certificates for names it is configured to serve.
# www.raidbingo.com {
# 	redir https://raidbingo.com{uri} permanent
# }
