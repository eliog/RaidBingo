# Copy to .env for local development. NEVER commit a filled-in copy.
# Generate each secret with:  openssl rand -hex 32
#
# The app refuses to start if any required value is missing or still reads
# REPLACE_ME. There are deliberately no fallback defaults in the code: a
# shipped default for PID_SECRET would make every deployment compute the
# same player ids from the same Discord accounts.

# --- Discord OAuth (register an app at discord.com/developers) ---
# Scope is `identify` only. No bot, no server admin rights needed.
DISCORD_CLIENT_ID=REPLACE_ME
DISCORD_CLIENT_SECRET=REPLACE_ME

# --- Secrets ---
# PID_SECRET derives every player id. Changing it detaches all history,
# so generate it ONCE and back it up somewhere other than the server.
PID_SECRET=REPLACE_ME
SESSION_SECRET=REPLACE_ME

# --- Deployment ---
# Used for the OAuth redirect URI, absolute Open Graph urls and share links.
# The redirect URI (BASE_URL + /auth/callback) must match what is registered
# in the Discord developer portal exactly.
BASE_URL=http://localhost:3000
PORT=3000
DB_PATH=./data/bingo.db
