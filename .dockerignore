# Only what the Dockerfile copies is needed; keep secrets and data out of the
# build context entirely, not just out of the image.
*
!package.json
!package-lock.json
!shared/
!server/
!client/
# Just enough git to name the running commit (#32): HEAD and the refs. No
# objects, no history, no config.
!.git/HEAD
!.git/refs/heads/
!.git/packed-refs
